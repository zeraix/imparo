+// WHAT A BATCH OF n_tok ROWS PAYS FOR, as one opaque number.
+//
+// Two row counts with the same class run the same tile over the same MMA token tiles, so
+// they cost the same; the cost can only move where the class changes. A caller choosing a
+// row count needs exactly that -- not a cost model, only the places the cost can step --
+// and the tile table stays here, where it already lives, instead of being restated.
+//
+//   tile          q8_tile's answer for n_tok
+//   token tiles   ceil(n_tok / 8), the MMA tile the kernel walks in (TOKEN_TILES = TOKENS/8)
+//
+// THE CLASS IS DELIBERATELY FINER THAN THE COST. The pad skip's real grain is one
+// SIMDGROUP's token rows, which is 8 times the simdgroup's tile count -- a template
+// parameter of the kernel, not a column of the shape table. Splitting on 8 instead can
+// only ever SPLIT a flat range in two, never MERGE two different costs, so a caller pays
+// one extra measurement where the pad skip is coarse and is never told that two row counts
+// cost the same when they do not. The wrong direction is the expensive one.
+//
+// Measured on LFM2, a 30-layer verify at a 443-token context: rows 2/4/6/8 read 29.3 /
+// 29.5 / 29.7 / 28.9 ms, rows 10/12/16 read 33.0 / 33.2 / 32.4, rows 20/24/32 read 45.3 /
+// 45.5 / 44.6 -- flat inside a class to under 1 ms, and every step lands where this changes.
+extern "C" uint64_t imparo_metal_matmat_row_class(uint32_t wkind, uint32_t n_tok) {
+    if (n_tok == 0u) { return 0u; }
+    // Only the Q8 families (2 = row-major, 3 = tile-major) take the tiled st_gemm route
+    // whose padding this answers. Every other kind goes to rt_gemm, whose narrow tile is a
+    // different table and has not been read against a measurement here; 0 says so rather
+    // than guessing, and a caller that needs to know must not invent a ladder.
+    if (wkind != 2u && wkind != 3u) { return 0u; }
+    // At or below the GEMV boundary the dispatch is not this GEMM at all -- it is the
+    // one-row kernel, whose cost is per row with no tile to pad to. Each width is its own
+    // class, tagged apart from every tile class.
+    if (n_tok <= g_gemv_max_tok) { return (1ull << 63) | (uint64_t)n_tok; }
+    const uint32_t shape = q8_tile(n_tok);
+    const uint32_t tiles = (n_tok + 7u) / 8u;
+    return ((uint64_t)shape << 32) | (uint64_t)tiles;
+}
